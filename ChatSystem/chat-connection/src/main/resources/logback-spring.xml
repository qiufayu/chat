<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_HOME" value="E:/Project/five/logs"/>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="application"/>

    <property name="CONSOLE_PATTERN" value="%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="FILE_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_HOME}/${APP_NAME}/error/error.log</file>
        <append>false</append>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>

    <!-- 原来的同步文件 appender 保持不变，改个名或保留都行 -->
    <appender name="DAILY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}/daily/daily.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}/daily/daily.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 新增：异步包装器 -->
    <appender name="ASYNC_DAILY_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 关键参数 -->
        <queueSize>1024</queueSize>          <!-- 队列容量，默认 256 -->
        <discardingThreshold>0</discardingThreshold>  <!-- 0 = 不丢弃，见下方说明 -->
        <neverBlock>false</neverBlock>        <!-- true = 队列满时丢弃而非阻塞，见下方说明 -->
        <includeCallerData>false</includeCallerData>  <!-- 默认 false，开 true 会影响性能 -->
        <appender-ref ref="DAILY_FILE"/>      <!-- 引用真正的文件 appender -->
    </appender>

    <logger name="com.fayu.connection" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="ASYNC_DAILY_FILE"/>
    </root>

</configuration>
